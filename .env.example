# Copiar para .dev.vars (runtime Cloudflare local) e/ou .env (build Vite).
# Nunca commitar valores reais.

# ── Supabase ────────────────────────────────────────────────────────────
# Lidas em runtime pelo Worker (SSR: middleware, páginas, endpoints).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só para endpoints server-side que precisem ignorar RLS de propósito.
# NUNCA expor ao navegador, nunca prefixar com PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mesmos valores de URL/anon key, expostos ao bundle do navegador (Vite
# faz o bake em build time). Usadas pelos componentes React de
# cadastro/login para chamar supabase.auth diretamente do cliente.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudflare R2 (preparado, ainda não usado neste MVP) ────────────────
# Nenhuma credencial de R2 deve chegar ao navegador. O binding do bucket
# (quando existir) é configurado no wrangler.jsonc, não aqui.
# R2_BUCKET_NAME=
